{%- comment -%}
  SJ CRO 1 (Off Leesh, Nov 2026): trust block under Add to cart. Plain facts only.
  Bats are prepped before dispatch (up to 3 business days); everything else ships in 1 to 3.
{%- endcomment -%}
{%- liquid
  assign is_bat = false
  if product.type contains 'Cricket Bat'
    assign is_bat = true
    if product.type contains 'Batting'
      assign is_bat = false
    endif
  endif
-%}
<ul class="sj-trust" role="list">
  <li>
    <span class="sj-trust__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
    <span>{% if is_bat %}<b>Prepped and sent in up to 3 business days</b>{% else %}<b>Sent in 1 to 3 business days</b>{% endif %}</span>
  </li>
  <li>
    <span class="sj-trust__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg></span>
    <span><b>Free standard shipping over $200</b> <span class="sj-trust__m">(bulky items excluded)</span></span>
  </li>
  <li>
    <span class="sj-trust__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 10c0 5-5.5 10.2-7.4 11.8a1 1 0 0 1-1.2 0C9.5 20.2 4 15 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg></span>
    <span><b>Pick up in Woolloongabba</b> <span class="sj-trust__m">60 Deshon St, open 7 days</span></span>
  </li>
  <li>
    <span class="sj-trust__ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></span>
    <span><b>Warranty and exchange</b> <a href="/pages/warranty-exchange">What's covered</a></span>
  </li>
  <li>
    <span class="sj-trust__ic sj-trust__ic--star" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M11.5 2.3a.5.5 0 0 1 1 0l2.3 4.7a2.1 2.1 0 0 0 1.6 1.2l5.2.8a.5.5 0 0 1 .3.9l-3.8 3.7a2.1 2.1 0 0 0-.6 1.9l.9 5.2a.5.5 0 0 1-.8.6l-4.6-2.5a2.1 2.1 0 0 0-2 0l-4.6 2.5a.5.5 0 0 1-.8-.6l.9-5.2a2.1 2.1 0 0 0-.6-1.9L2.1 9.9a.5.5 0 0 1 .3-.9l5.2-.8a2.1 2.1 0 0 0 1.6-1.2z"/></svg></span>
    <span><b>4.9 from 110 Google reviews</b> <a href="https://www.google.com/maps/search/?api=1&query=SJ+Sports+60+Deshon+St+Woolloongabba" target="_blank" rel="noopener">Read them on Google</a></span>
  </li>
</ul>
<p class="sj-call">Not sure what to choose? Call the shop on <a href="tel:0423240478">0423 240 478</a></p>
<script id="sj-preselect">
  /* SJ CRO 2: preselect "Prepare my bat" so the free prep is saved on every bat order unless the shopper changes it */
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.t4s-line-item-property__field.is--type-radio').forEach(function (f) {
      if (!f.querySelector('input:checked')) { var r = f.querySelector('input[type=radio]'); if (r) r.checked = true; }
    });
  });
</script>

<!doctype html>
{%- liquid
  assign t_name = request.page_type
  assign iso_code = request.locale.iso_code
  assign use_rtl = settings.use_rtl
  if use_rtl == '2'
    assign lis_rtl = 'ar; dv; ha; he; ku; fa; ur; ug; ps; yi'
    assign iso_code_ck = iso_code | split: '-' | first
  else
    assign iso_code_ck = iso_code
    assign lis_rtl = settings.list_rtl
  endif
  if use_rtl == '1'
    assign isRTL = true
  elsif lis_rtl contains iso_code_ck and use_rtl == '2' or use_rtl == '3'
    assign isRTL = true
  else
    assign isRTL = false
  endif
  assign body_img = settings.body_bg_image
  if body_img != blank
    assign class_lazy = 'lazyloadt4s'
  endif
-%}
{%- capture class_html -%}
t4sp-theme t4s-wrapper__{{ settings.general_layout }} rtl_{{ isRTL }} swatch_color_style_{{ settings.swatch_color_style }} pr_border_style_{{ settings.pr_border_style }} pr_img_effect_{{ settings.pr_img_effect }} enable_eff_img1_{{ settings.enable_eff_img1 }} badge_shape_{{ settings.badge_shape }} css_for_wis_app_{{ settings.enable_css_wis }}{% if settings.use_cus_lz and settings.cus_lz %} t4s-lzcus-true{% endif %} shadow_round_img_{{ settings.enable_shadow_round_img }} t4s-header__{{ settings.header_design }} is-remove-unavai-{{ settings.variant_remove }} t4_compare_{{ settings.enable_compe }}{% if settings.type_qv == '1' %} t4s-sidebar-qv{% endif %} t4s-cart-count-{{ cart.item_count }} t4s-pr-ellipsis-{{ settings.enable_pr_ellipsis }}
{%- endcapture -%}
{%- capture t4s_main_content -%}{{ content_for_layout }}{%- endcapture -%}
{%- liquid
  assign t4s_lcp_desktop_href = blank
  assign t4s_lcp_desktop_srcset = blank
  assign t4s_lcp_desktop_sizes = '100vw'
  assign t4s_lcp_mobile_href = blank
  assign t4s_lcp_mobile_srcset = blank

  if t4s_main_content contains '<!-- t4s-lcp-desktop-href:'
    assign lcp_marker_parts = t4s_main_content | split: '<!-- t4s-lcp-desktop-href:'
    assign t4s_lcp_desktop_href = lcp_marker_parts[1] | split: ':t4s-lcp-end -->' | first | strip
    assign lcp_marker_parts = t4s_main_content | split: '<!-- t4s-lcp-desktop-srcset:'
    assign t4s_lcp_desktop_srcset = lcp_marker_parts[1] | split: ':t4s-lcp-end -->' | first | strip
    assign lcp_marker_parts = t4s_main_content | split: '<!-- t4s-lcp-desktop-sizes:'
    assign t4s_lcp_desktop_sizes = lcp_marker_parts[1] | split: ':t4s-lcp-end -->' | first | strip
    assign lcp_marker_parts = t4s_main_content | split: '<!-- t4s-lcp-mobile-href:'
    assign t4s_lcp_mobile_href = lcp_marker_parts[1] | split: ':t4s-lcp-end -->' | first | strip
    assign lcp_marker_parts = t4s_main_content | split: '<!-- t4s-lcp-mobile-srcset:'
    assign t4s_lcp_mobile_srcset = lcp_marker_parts[1] | split: ':t4s-lcp-end -->' | first | strip
  endif
-%}
<html
  class="{{ class_html }} no-js"
  lang="{{ iso_code }}"
  {% if isRTL %}
    dir="rtl"
  {% endif %}
>
  <head>
    	<!-- Added by APP PLAZA -->
	{% include 'app-plaza' %}
  {% include 'avada-seo' %}
	<!-- /Added by APP PLAZA -->
	<meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    >
    <meta name="theme-color" content="{{ settings.body_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.font_source == '1' -%}
      {%- unless settings.fnt_fm_sp1.system? and settings.fnt_fm_sp2.system? and settings.fnt_fm_sp3.system? -%}
        <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {%- endunless -%}
    {%- endif -%}
    {%- if t4s_lcp_desktop_href != blank -%}
      <link rel="preload" as="image" href="{{ t4s_lcp_desktop_href }}" imagesrcset="{{ t4s_lcp_desktop_srcset }}" imagesizes="{{ t4s_lcp_desktop_sizes }}" media="(min-width: 768px)" fetchpriority="high">
      <link rel="preload" as="image" href="{{ t4s_lcp_mobile_href }}" imagesrcset="{{ t4s_lcp_mobile_srcset }}" imagesizes="100vw" media="(max-width: 767px)" fetchpriority="high">
    {%- endif -%}
    {%- render 'head_assets', t_name: t_name, isRTL: isRTL -%}
    {%- render 'avada-customize' -%}
    <!-- BEGIN MerchantWidget Code -->

<script id='merchantWidgetScript'

        src="https://www.gstatic.com/shopping/merchant/merchantwidget.js"

        defer>

</script>

<script type="text/javascript">

  merchantWidgetScript.addEventListener('load', function () {

    merchantwidget.start({

     position: 'RIGHT_BOTTOM'

   });

  });

</script>

<!-- END MerchantWidget Code -->

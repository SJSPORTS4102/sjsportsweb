<script>
  (function () {
    var root = document.querySelector('[data-sjsg]'); if (!root) return;
    var num = root.querySelector('[data-sjsg-num]'), rng = root.querySelector('[data-sjsg-rng]');
    var rows = [].slice.call(root.querySelectorAll('[data-sjsg-row]'));
    var size = root.querySelector('[data-sjsg-size]'), meta = root.querySelector('[data-sjsg-meta]'), shop = root.querySelector('[data-sjsg-shop]');
    if (!num || !rng || !rows.length) return;
    function pick(h) { for (var i = 0; i < rows.length; i++) { if (h <= +rows[i].dataset.max) return rows[i]; } return rows[rows.length - 1]; }
    function fill() { var mn = +rng.min, mx = +rng.max; rng.style.setProperty('--p', ((+rng.value - mn) / (mx - mn) * 100) + '%'); }
    var last = null;
    function update(h, from) {
      if (isNaN(h) || h < 50 || h > 250) return;
      if (from !== 'num') num.value = Math.round(h);
      if (from !== 'rng') rng.value = Math.min(Math.max(Math.round(h), +rng.min), +rng.max);
      fill();
      var r = pick(h); if (r === last) return; last = r;
      rows.forEach(function (x) { x.classList.toggle('is-on', x === r); });
      size.textContent = r.dataset.name; meta.textContent = r.dataset.meta;
      shop.href = r.dataset.url; shop.querySelector('span').textContent = 'Shop ' + r.dataset.short + ' bats';
    }
    num.addEventListener('input', function () { update(parseFloat(num.value), 'num'); });
    rng.addEventListener('input', function () { update(+rng.value, 'rng'); });
    last = root.querySelector('[data-sjsg-row].is-on'); fill();
  })();
  (function () {
    var head = document.querySelector('[data-sjsg-adult]'), wrap = document.querySelector('[data-sjsg-adult-grid]'); if (!head || !wrap) return;
    function gone() { head.remove(); wrap.remove(); }
    function load() {
      fetch(head.dataset.url).then(function (r) { return r.ok ? r.text() : ''; }).then(function (html) {
        var ul = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-sjsg-cards]');
        if (!ul || ul.children.length < 2) { gone(); return; }
        var grid = wrap.querySelector('.sjcol-grid'); grid.innerHTML = ''; grid.removeAttribute('aria-busy');
        [].slice.call(ul.children).forEach(function (c) { grid.appendChild(document.importNode(c, true)); });
      }).catch(gone);
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (e) { if (e[0].isIntersecting) { io.disconnect(); load(); } }, { rootMargin: '600px 0px' });
      io.observe(wrap);
    } else { load(); }
  })();
</script>

<style>
  .sjsg{--navy:#005186;--navy-deep:#0A2E4D;--cta:#A81C60;--sun:#FFC72C;--ink:#0F2236;--muted:#475569;--line:#E1E7EE;--soft:#F4F7FA;--soft-2:#EAF1F7;
    --head:'Barlow Condensed',system-ui,sans-serif;--body:'Barlow',system-ui,sans-serif;font-family:var(--body);color:var(--ink);font-size:16px;line-height:1.55;background:#fff}
  .sjsg *,.sjsg *::before,.sjsg *::after{box-sizing:border-box}
  .sjsg :where(h1,h2,h3,p,ol,ul,li,dl,dt,dd){margin:0;padding:0}
  .sjsg :where(ol,ul){list-style:none}
  .sjsg .i{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
  .sjsg :focus-visible{outline:3px solid var(--sun);outline-offset:2px}
  .sjsg .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .sjsg .in{max-width:1464px;margin:0 auto;padding:0 16px}
  .sjsg .eye{font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--navy)}
  .sjsg .h2{font-family:var(--head)!important;font-weight:800!important;font-size:32px!important;line-height:1.02!important;text-transform:uppercase;letter-spacing:.01em!important;color:var(--ink)!important;margin-top:6px!important}
  .sjsg .h2 span{color:var(--cta)}
  .sjsg h3{font-family:var(--body)!important;font-size:18px!important;font-weight:700!important;line-height:1.3!important;letter-spacing:0!important;text-transform:none!important;color:var(--ink)!important}
  .sjsg .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 22px;border-radius:10px;font:700 16px/1 var(--body);text-decoration:none;cursor:pointer;transition:background-color .2s,border-color .2s,color .2s}
  .sjsg .btn.sun{background:var(--sun);color:var(--navy-deep)}
  .sjsg .btn.sun:hover{background:#FFD65E}
  .sjsg .btn.cta{background:var(--cta);color:#fff}
  .sjsg .btn.cta:hover{background:#8E1650}
  .sjsg .btn.ghost{border:1.5px solid rgba(255,255,255,.5);color:#fff}
  .sjsg .btn.ghost:hover{border-color:#fff;background:rgba(255,255,255,.08)}
  .sjsg .more{display:inline-flex;align-items:center;gap:6px;min-height:44px;font-weight:700;color:var(--navy);text-decoration:none}
  .sjsg .more:hover{text-decoration:underline;text-underline-offset:3px}

  /* hero */
  .sjsg-hero{background:var(--navy-deep);color:#fff;padding:18px 0 28px;overflow:hidden}
  .sjsg-hero .in{display:grid;gap:22px}
  .sjsg .crumbs{display:flex;flex-wrap:wrap;gap:6px;font-size:14px;color:#AFC1D3;margin-bottom:14px}
  .sjsg .crumbs a{color:#DCE6F0;text-decoration:none}
  .sjsg .crumbs a:hover{text-decoration:underline}
  .sjsg-hero .eye{color:var(--sun)}
  .sjsg-hero h1{font-family:var(--head)!important;font-weight:800!important;font-size:42px!important;line-height:.98!important;text-transform:uppercase;letter-spacing:.01em!important;color:#fff!important;margin-top:8px!important}
  .sjsg-hero .lede{margin-top:14px!important;font-size:17px;line-height:1.55;color:#D9E4EF;max-width:58ch}
  .sjsg-hero .lede b{color:#fff}
  .sjsg-hero .facts{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:18px}
  .sjsg-hero .facts li{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:600;color:#DCE6F0}
  .sjsg-hero .facts .i{color:var(--sun)}

  /* finder */
  .sjsg .finder{background:#fff;color:var(--ink);border-radius:16px;padding:20px 18px 18px;box-shadow:0 24px 48px rgba(0,0,0,.22)}
  .sjsg .finder .ft{font-family:var(--head)!important;font-weight:800!important;font-size:26px!important;line-height:1!important;text-transform:uppercase;color:var(--ink)!important;letter-spacing:.01em!important}
  .sjsg .finder .fl{display:block;margin-top:12px;font-size:15px;font-weight:600;color:var(--muted)}
  .sjsg .finder .hrow{display:flex;align-items:baseline;gap:8px;margin-top:6px}
  .sjsg .finder .num{width:120px!important;height:56px!important;min-height:0!important;padding:0 12px!important;margin:0!important;border:1.5px solid var(--line)!important;border-radius:10px!important;background:var(--soft)!important;font:800 30px/1 var(--head)!important;color:var(--ink)!important;box-shadow:none!important}
  .sjsg .finder .num:focus{border-color:var(--navy)!important;box-shadow:0 0 0 3px #00518633!important;outline:none}
  /* beats the site-wide 16px phone rule for inputs (sj-cro.css); 30px is bigger, so no iOS zoom either */
  .sjsg .finder .hrow input.num[type=number]{font-size:30px!important}
  .sjsg .finder .unit{font:700 20px var(--head);text-transform:uppercase;color:var(--muted)}
  .sjsg .rng{-webkit-appearance:none;appearance:none;display:block;width:100%;height:44px;margin:6px 0 0;padding:0;background:transparent;cursor:pointer;border:0}
  .sjsg .rng::-webkit-slider-runnable-track{height:8px;border-radius:99px;background:linear-gradient(90deg,var(--navy) var(--p,50%),var(--line) var(--p,50%))}
  .sjsg .rng::-webkit-slider-thumb{-webkit-appearance:none;width:30px;height:30px;margin-top:-11px;border-radius:50%;background:#fff;border:3px solid var(--navy);box-shadow:0 2px 8px rgba(10,46,77,.28)}
  .sjsg .rng::-moz-range-track{height:8px;border-radius:99px;background:var(--line)}
  .sjsg .rng::-moz-range-progress{height:8px;border-radius:99px;background:var(--navy)}
  .sjsg .rng::-moz-range-thumb{width:26px;height:26px;border-radius:50%;background:#fff;border:3px solid var(--navy)}
  .sjsg .rng:focus-visible{outline-offset:4px}
  .sjsg .scale{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-top:-2px}
  .sjsg .res{display:flex;flex-direction:column;gap:2px;margin-top:14px;padding:14px 16px;border-radius:12px;background:var(--soft-2)}
  .sjsg .res .rl{font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--navy)}
  .sjsg .res b{font-family:var(--head);font-weight:800;font-size:34px;line-height:1.02;text-transform:uppercase;color:var(--ink)}
  .sjsg .res .rm{font-size:15.5px;color:var(--muted)}
  .sjsg .finder .btn{width:100%;margin-top:14px}
  .sjsg .finder .tip{display:flex;align-items:center;gap:8px;margin-top:12px!important;font-size:14.5px;color:var(--muted)}
  .sjsg .finder .tip .i{width:18px;height:18px;color:var(--navy)}

  /* on this page */
  .sjsg-jump{border-bottom:1px solid var(--line);background:#fff}
  .sjsg-jump ul{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none;padding:12px 0!important;margin:0 -16px!important;padding-left:16px!important;padding-right:16px!important}
  .sjsg-jump ul::-webkit-scrollbar{display:none}
  .sjsg-jump a{display:inline-flex;align-items:center;min-height:40px;padding:0 14px;border-radius:999px;border:1.5px solid var(--line);color:var(--ink);font-weight:600;font-size:15px;text-decoration:none;white-space:nowrap;transition:border-color .2s,color .2s}
  .sjsg-jump a:hover{border-color:var(--navy);color:var(--navy)}

  /* sections */
  .sjsg-sec{padding:40px 0;scroll-margin-top:var(--sjn-stack,80px)}
  .sjsg-sec.soft{background:var(--soft)}
  .sjsg .row-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px}
  .sjsg .row-head .more{flex:none}

  /* chart */
  .sjsg .chart-wrap{margin-top:20px;border:1px solid var(--line);border-radius:14px;overflow:hidden;max-width:980px}
  .sjsg table.chart{width:100%;border-collapse:collapse;border-spacing:0;margin:0!important;font-size:15.5px;table-layout:auto}
  .sjsg .chart th,.sjsg .chart td{border:0!important;padding:12px 10px!important;text-align:left;vertical-align:middle;background:none}
  .sjsg .chart thead th{background:var(--navy)!important;color:#fff!important;font-size:13px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;line-height:1.25}
  .sjsg .chart thead small{display:block;font-weight:500;letter-spacing:0;text-transform:none;opacity:.85}
  .sjsg .chart tbody tr{border-top:1px solid var(--line);transition:background-color .2s}
  .sjsg .chart tbody tr:nth-child(even){background:#FAFBFC}
  .sjsg .chart tbody th{font-weight:700;color:var(--ink);font-size:16px;line-height:1.3}
  .sjsg .chart tbody td{color:var(--ink)}
  .sjsg .chart .tag{display:none}
  .sjsg .chart tr.grp th{background:var(--soft-2)!important;color:var(--navy)!important;font-size:12.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:8px 10px!important}
  .sjsg .chart tr.is-on{background:var(--soft-2)!important;box-shadow:inset 4px 0 0 var(--navy)}
  .sjsg .chart tr.is-on .tag{display:inline-block;margin:0 0 4px;padding:2px 8px;border-radius:999px;background:var(--navy);color:#fff;font-size:11.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;width:max-content}
  .sjsg .chart tr.is-on th{display:flex;flex-direction:column;align-items:flex-start}
  .sjsg .chart td.go{width:1%;white-space:nowrap;text-align:right;padding-right:6px!important}
  .sjsg .chart td.go a{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-width:44px;min-height:44px;padding:0 10px;border-radius:8px;color:var(--navy);font-weight:700;text-decoration:none}
  .sjsg .chart td.go a span{display:none}
  .sjsg .chart td.go a:hover{background:#fff}
  .sjsg .fine{margin-top:12px!important;font-size:14.5px;color:var(--muted)}

  /* check at home */
  .sjsg .steps{display:grid;gap:12px;margin-top:22px}
  .sjsg .steps li{position:relative;background:#fff;border:1px solid var(--line);border-radius:14px;padding:18px 18px 18px 72px;min-height:96px}
  .sjsg .steps .no{position:absolute;left:18px;top:18px;width:40px;height:40px;border-radius:50%;background:var(--navy);color:#fff;display:grid;place-items:center;font:800 20px/1 var(--head)}
  .sjsg .steps p{margin-top:4px!important;color:var(--muted)}
  .sjsg .note{margin-top:14px;border-left:4px solid var(--cta);background:#fff;border-radius:0 12px 12px 0;padding:16px 18px}
  .sjsg .note p{margin-top:6px!important;color:var(--muted);max-width:75ch}

  /* willow */
  .sjsg .willow{display:grid;gap:12px;margin-top:22px}
  .sjsg .wc{display:flex;flex-direction:column;gap:10px;border:1px solid var(--line);border-radius:14px;padding:20px}
  .sjsg .wc h3{font-family:var(--head)!important;font-weight:800!important;font-size:26px!important;text-transform:uppercase!important;line-height:1!important}
  .sjsg .wc .pts{display:flex;flex-wrap:wrap;gap:6px}
  .sjsg .wc .pts li{padding:4px 10px;border-radius:999px;background:var(--soft-2);color:var(--navy);font-size:14px;font-weight:600}
  .sjsg .wc p{color:var(--muted)}
  .sjsg .wc .prep{display:flex;gap:8px;align-items:flex-start;padding:10px 12px;border-radius:10px;background:var(--soft);color:var(--ink);font-size:15px}
  .sjsg .wc .prep .i{color:var(--navy);margin-top:2px}
  .sjsg .wc .prep a{color:var(--navy);font-weight:700}
  .sjsg .wc .more:first-of-type{margin-top:auto}

  /* bats */
  .sjsg-rail{padding:0!important;margin-top:18px}
  .sjsg-rail .sjcol-grid{display:grid;grid-auto-flow:column;grid-auto-columns:44%;grid-template-columns:none;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;margin:0 -16px!important;padding:0 16px 4px!important;scroll-padding:0 16px}
  .sjsg-rail .sjcol-grid::-webkit-scrollbar{display:none}
  .sjsg-rail .sjc-card{scroll-snap-align:start}
  .sjsg .row-head.adult{margin-top:40px}
  .sjsg-skel .im{display:block;aspect-ratio:1;border-radius:12px;background:#fff}
  .sjsg-skel .l{display:block;height:12px;width:85%;border-radius:6px;background:#fff;margin-top:12px}
  .sjsg-skel .l.s{width:45%}
  .sjsg .bigger{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:18px}
  .sjsg .bigger span{font-weight:700;margin-right:4px}
  .sjsg .bigger a{display:inline-flex;align-items:center;min-height:40px;padding:0 14px;border-radius:999px;background:#fff;border:1.5px solid var(--line);color:var(--ink);font-weight:600;font-size:15px;text-decoration:none}
  .sjsg .bigger a:hover{border-color:var(--navy);color:var(--navy)}

  /* kit */
  .sjsg .kit{display:grid;gap:12px;margin-top:22px}
  .sjsg .kc{display:flex;flex-direction:column;gap:10px;border:1px solid var(--line);border-radius:14px;padding:20px}
  .sjsg .kc .how{color:var(--muted)}
  .sjsg .kc .how b{color:var(--ink)}
  .sjsg .kc dl{border-top:1px solid var(--line)}
  .sjsg .kc dl div{display:flex;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid var(--line)}
  .sjsg .kc dt{font-weight:600}
  .sjsg .kc dd{color:var(--muted);font-variant-numeric:tabular-nums}
  .sjsg .kc .more{margin-top:auto}
  .sjsg .kits{margin-top:16px!important;color:var(--muted)}
  .sjsg .kits b{color:var(--ink)}
  .sjsg .kits a{color:var(--navy);font-weight:700}

  /* faq */
  .sjsg .faq{margin-top:18px;border-top:1px solid var(--line);max-width:880px}
  .sjsg .faq details{border-bottom:1px solid var(--line)}
  .sjsg .faq summary{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:56px;padding:12px 0;font-weight:700;font-size:17px;cursor:pointer;list-style:none}
  .sjsg .faq summary::-webkit-details-marker{display:none}
  .sjsg .faq summary .i{transition:transform .2s;color:var(--navy)}
  .sjsg .faq details[open] summary .i{transform:rotate(90deg)}
  .sjsg .faq details p{padding:0 0 16px!important;color:var(--muted);max-width:65ch}

  /* end band */
  .sjsg-end{background:var(--navy);color:#fff;padding:32px 0}
  .sjsg-end .in{display:grid;gap:18px}
  .sjsg-end h2{font-family:var(--head)!important;font-weight:800!important;font-size:32px!important;line-height:1!important;text-transform:uppercase;color:#fff!important;letter-spacing:.01em!important}
  .sjsg-end h2 span{color:var(--sun)}
  .sjsg-end p{margin-top:8px!important;color:#D9E4EF;max-width:60ch}
  .sjsg-end .ctas{display:flex;flex-wrap:wrap;gap:10px}
  .sjsg-end .ctas .btn{flex:1 1 220px}

  @media (min-width:768px){
    .sjsg .in{padding:0 24px}
    .sjsg-jump ul{margin:0 -24px!important;padding-left:24px!important;padding-right:24px!important}
    .sjsg .chart td.go a span{display:inline}
    .sjsg .chart th,.sjsg .chart td{padding:13px 18px!important}
    .sjsg .steps{grid-template-columns:repeat(2,1fr)}
    .sjsg .willow{grid-template-columns:repeat(2,1fr)}
    .sjsg .kit{grid-template-columns:repeat(3,1fr)}
    .sjsg-rail .sjcol-grid{grid-auto-columns:calc((100% - 36px) / 3.3);margin:0 -24px!important;padding:0 24px 4px!important;scroll-padding:0 24px}
    .sjsg-hero .in{grid-template-columns:1fr 360px;align-items:center;gap:32px}
  }
  @media (min-width:1025px){
    .sjsg .in{padding:0 32px}
    .sjsg-jump ul{margin:0!important;padding-left:0!important;padding-right:0!important}
    .sjsg .h2{font-size:44px!important}
    .sjsg-hero{padding:28px 0 56px}
    .sjsg-hero .in{grid-template-columns:1.2fr 420px;gap:72px}
    .sjsg-hero h1{font-size:64px!important}
    .sjsg-hero .lede{font-size:19px}
    .sjsg .finder{padding:26px 26px 22px}
    .sjsg-sec{padding:64px 0}
    .sjsg .steps{grid-template-columns:repeat(4,1fr);gap:16px}
    .sjsg .steps li{padding:22px 20px;min-height:0}
    .sjsg .steps .no{position:static;margin-bottom:14px}
    .sjsg-rail .sjcol-grid{grid-auto-flow:row;grid-auto-columns:auto;grid-template-columns:repeat(4,1fr);gap:20px;overflow:visible;margin:0!important;padding:0!important}
    .sjsg-end{padding:48px 0}
    .sjsg-end .in{grid-template-columns:1fr auto;align-items:center;gap:32px}
    .sjsg-end h2{font-size:44px!important}
    .sjsg-end .ctas .btn{flex:0 0 auto}
  }
  @media (prefers-reduced-motion:reduce){ .sjsg *{transition:none!important} html{scroll-behavior:auto} }
</style>

{%- endif -%}

{% schema %}
{
  "name": "SJ bat size guide",
  "class": "sjsg-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cricket bat size chart" },
    { "type": "range", "id": "start", "label": "Height the finder starts at (cm)", "min": 100, "max": 200, "step": 1, "default": 140 },
    { "type": "product_list", "id": "products", "label": "Popular junior bats", "limit": 8, "info": "Leave empty to use the four from the article." }
  ]
}
{% endschema %}

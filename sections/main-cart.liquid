    <div class="sjcp-sticky__t"><small>Subtotal</small><b data-sjcp-sticky-total>{{ total_price | money }}</b></div>
    <button type="button" class="sjcp-sticky__btn" data-sjcp-go><svg class="sjcp-i" viewBox="0 0 24 24" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>Checkout</button>
  </div>
  <script>
    /* phones: a checkout bar while the summary's Checkout is off screen (hidden at the footer);
       it clicks the real button, so the pickup app's checks and the terms box still apply */
    (function (run) { if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run(); })(function () {
      var root = document.querySelector('[data-sjcp]'); if (!root) return;
      var hasIO = 'IntersectionObserver' in window;
      var bar = root.querySelector('[data-sjcp-sticky]'), foot = document.querySelector('footer.sjf') || document.querySelector('footer');
      var mq = window.matchMedia('(max-width: 1023px)'), ckSeen = true, footSeen = false;
      function ck() { return document.getElementById('checkout'); }
      function update() {
        var show = mq.matches && !ckSeen && !footSeen && !!root.querySelector('[data-cart-item]');
        bar.hidden = !show;
        if (show) { var t = root.querySelector('.sjcp-totals .t4s-cart__totalPrice'), o = bar.querySelector('[data-sjcp-sticky-total]'); if (t && o) o.textContent = t.textContent.trim(); }
      }
      if (hasIO) {
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.target === foot) footSeen = e.isIntersecting; else ckSeen = e.isIntersecting; }); update(); });
        if (ck()) io.observe(ck()); if (foot) io.observe(foot);
      }
      bar.querySelector('[data-sjcp-go]').addEventListener('click', function () {
        var b = ck(); if (b && !b.disabled) { b.click(); return; }
        var side = root.querySelector('.sjcp-side'); if (side) side.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      /* "Goes with your order" on this page: the drawer's add script isn't loaded here, so add, tag it,
         then Gecko's cart:refresh redraws the page in place */
      if (!window.__sjcUp) { window.__sjcUp = 1; document.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('[data-sjc-add]'); if (!b) return; e.preventDefault();
        var row = b.closest('[data-sjc-up]'), sel = row.querySelector('[data-sjc-variant]'), err = row.querySelector('.sjc-up__err');
        var id = +(sel ? sel.value : b.dataset.vid); b.disabled = true; b.classList.add('is-busy'); b.textContent = 'Adding'; if (err) err.hidden = true;
        fetch(((window.Shopify && Shopify.routes) ? Shopify.routes.root : '/') + 'cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: [{ id: id, quantity: 1, properties: { _sj_upsell: 'cart page' } }] }) })
          .then(function (r) { return r.json().then(function (j) { if (!r.ok) throw new Error(j.description || 'Could not add that one'); return j; }); })
          .then(function () { b.textContent = 'Added'; document.dispatchEvent(new CustomEvent('cart:refresh')); })
          .catch(function (x) { b.disabled = false; b.classList.remove('is-busy'); b.textContent = 'Add'; if (err) { err.textContent = x.message; err.hidden = false; } });
      }); }
      /* after the last item is removed, Gecko only swaps the item list: hide the summary too */
      var items = root.querySelector('[data-cart-items]');
      if (items) new MutationObserver(function () { root.classList.toggle('is-empty', !items.querySelector('[data-cart-item]')); update(); }).observe(items, { childList: true, subtree: true });
    });
  </script>
  {%- endif -%}

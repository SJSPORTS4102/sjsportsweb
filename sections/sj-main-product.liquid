{%- comment -%}
  SJ product page v3 (Off Leesh, Nov 2026). Built from the approved mockups in
  "SJ Sports CRO Mockups" (bat + bowling machine pages, design-system/sj-sports/MASTER.md).
  Theme copy only. Replaces the Gecko main-product section in templates/product.json
  (that section is switched off, not deleted, so it can be turned back on).
  Specs and features come from each product's own description (list items with a bold label
  become spec rows, plain list items become features), so it works for every product.
  Bat prep and preferred weight save as the same line item properties as before:
  "Bat prep" and "Preferred weight".
{%- endcomment -%}
{%- liquid
  assign cv = product.selected_or_first_available_variant
  assign t = product.type | downcase
  assign tl = product.title | downcase
  assign is_bat = false
  assign has_prep = false
  assign is_machine = false
  assign is_525 = false
  # "cricket batting pads" and "cricket batting gloves" also contain "cricket bat"
  if t contains 'cricket bat'
    unless t contains 'batting'
      assign is_bat = true
      assign has_prep = true
      if t contains 'kashmir' or tl contains 'kashmir'
        assign has_prep = false
      endif
    endunless
  endif
  if tl contains 'bowling machine'
    unless tl contains ' ball' or tl contains 'bucket'
      assign is_machine = true
      if tl contains 'paceman' and tl contains '525'
        assign is_525 = true
      endif
    endunless
  endif
  assign kind = 'other'
  if is_bat
    assign kind = 'bat'
  elsif is_machine
    assign kind = 'machine'
  endif

  if is_bat
    if tl contains 'english willow' or has_prep
      assign t_label = 'English willow'
    else
      assign t_label = 'Kashmir willow'
    endif
  elsif is_machine
    assign t_label = 'Bowling machine'
  else
    assign t_label = product.type | split: ' - ' | last | remove_first: 'Cricket ' | strip
  endif

  # description: lead paragraph, spec rows (bold label: value) and plain features
  assign desc = product.description | replace: '&nbsp;', ' '
  assign main_desc = desc | split: 'Preparation Includes' | first
  assign lead = ''
  assign paras = main_desc | split: '<p'
  for pp in paras offset: 1
    assign pbody = pp | split: '</p>' | first
    assign txt = '<p' | append: pbody | strip_html | strip
    if txt.size > 40
      assign lead = txt | replace: ' – ', ', ' | replace: '–', ' to ' | replace: ' — ', ', ' | replace: '—', ', '
      break
    endif
  endfor
  assign spec_rows = ''
  assign feat_rows = ''
  assign n_spec = 0
  assign n_feat = 0
  assign lis = main_desc | split: '<li'
  for li in lis offset: 1
    assign body = li | split: '</li>' | first
    assign full = '<li' | append: body
    assign plain = full | strip_html | strip | replace: ' – ', ', ' | replace: '–', ' to ' | replace: ' — ', ', ' | replace: '—', ', '
    if plain == blank
      continue
    endif
    assign done = false
    if body contains '</strong>'
      assign kp = full | split: '</strong>'
      assign key = kp[0] | strip_html | strip | remove: ':' | strip
      assign val = full | remove_first: kp[0] | strip_html | strip | remove_first: ':' | strip | replace: ' – ', ', ' | replace: '–', ' to ' | replace: ' — ', ', ' | replace: '—', ', '
      if key != blank and val != blank and n_spec < 10
        assign spec_rows = spec_rows | append: '<tr><th scope="row">' | append: key | append: '</th><td>' | append: val | append: '</td></tr>'
        assign n_spec = n_spec | plus: 1
        assign done = true
      endif
    endif
    if done == false and n_feat < 10
      assign feat_rows = feat_rows | append: '<li>' | append: plain | append: '</li>'
      assign n_feat = n_feat | plus: 1
    endif
  endfor

  # Paceman ball add-ons and the "takes all Paceman balls" line only apply to the 525
  assign addon_kind = kind
  if is_machine and is_525 == false
    assign addon_kind = 'none'
  endif
  assign media_count = product.media.size
  assign form_id = 'sjp-form-' | append: section.id
  assign google_url = 'https://www.google.com/maps/search/?api=1&query=SJ+Sports+60+Deshon+St+Woolloongabba'
-%}
{{ 'sj-pdp.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="{{ 'sj-pdp.js' | asset_url }}" defer></script>


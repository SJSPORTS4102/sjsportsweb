{%- comment -%}
  SJ Black Friday banner (Off Leesh, Nov 2026). Background art made with Google's image model (Nano Banana Pro),
  no text baked in: the headline, offer and buttons are live text so they stay sharp and editable at every size.
  Phones get a portrait 4:5 image with the text over the top half; tablets and desktops get a 21:9 image with the
  text on the left. The offer line stays hidden until it is filled in (the Black Friday offer is not set yet).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign d1 = 'sj-bfcm-desk-1440.webp' | asset_url
  assign d2 = 'sj-bfcm-desk-2400.webp' | asset_url
  assign p1 = 'sj-bfcm-phone-720.webp' | asset_url
  assign p2 = 'sj-bfcm-phone-1080.webp' | asset_url
-%}
<section class="sjbf" aria-labelledby="sjbf-h-{{ section.id }}">
  <picture class="sjbf-art">
    <source media="(min-width: 768px)" srcset="{{ d1 }} 1440w, {{ d2 }} 2400w" sizes="100vw">
    <img src="{{ p2 }}" srcset="{{ p1 }} 720w, {{ p2 }} 1080w" sizes="100vw" width="1080" height="1341" alt="" fetchpriority="high">
  </picture>
  <div class="sjbf-in">
    {%- if s.eyebrow != blank -%}<p class="sjbf-eye">{{ s.eyebrow }}</p>{%- endif -%}
    <h2 class="sjbf-h" id="sjbf-h-{{ section.id }}">{{ s.heading }}{% if s.heading_2 != blank %}<span>{{ s.heading_2 }}</span>{% endif %}</h2>
    {%- if s.offer != blank -%}<p class="sjbf-offer">{{ s.offer }}</p>{%- endif -%}
    <ul class="sjbf-usp" role="list">
      <li>Free bat prep</li><li>Free shipping over $200</li><li>Pick up in Woolloongabba</li>
    </ul>
    <div class="sjbf-cta">
      {%- if s.btn1_label != blank -%}<a class="sjbf-b1" href="{{ s.btn1_url | default: '/collections/black-friday-sale' }}">{{ s.btn1_label }}</a>{%- endif -%}
      {%- if s.btn2_label != blank -%}<a class="sjbf-b2" href="{{ s.btn2_url | default: '/collections/cricket-bat?sort_by=best-selling' }}">{{ s.btn2_label }}</a>{%- endif -%}
    </div>
    {%- if s.fine != blank -%}<p class="sjbf-fine">{{ s.fine }}</p>{%- endif -%}
  </div>
</section>
<style>
  .sjbf{position:relative;overflow:hidden;background:#06192B;color:#fff;font-family:'Barlow',system-ui,sans-serif;isolation:isolate}
  .sjbf-art img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:70% 100%;z-index:-1}
  .sjbf-in{position:relative;max-width:1464px;margin:0 auto;padding:26px 20px calc(min(125vw,640px) * .52);display:flex;flex-direction:column;align-items:flex-start;gap:10px;min-height:min(125vw,640px)}
  .sjbf-eye{margin:0;font-size:13px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:#FFB3D3}
  .sjbf-h{margin:0!important;font-family:'Barlow Condensed',system-ui,sans-serif!important;font-weight:800!important;font-size:clamp(40px,11.5vw,60px)!important;line-height:.92!important;text-transform:uppercase;letter-spacing:.005em!important;color:#fff!important;max-width:14ch}
  .sjbf-h span{display:block;color:#FF5EA8}
  .sjbf-offer{margin:2px 0 0;font-family:'Barlow Condensed',system-ui,sans-serif;font-weight:800;font-size:clamp(34px,10vw,48px);line-height:1;color:#FFC72C;text-transform:uppercase;letter-spacing:.005em;max-width:18ch}
  .sjbf-usp{list-style:none;margin:2px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:4px 14px;font-size:14.5px;font-weight:600;color:#DCE6F0}
  .sjbf-usp li:nth-child(3){display:none}
  .sjbf-usp li{display:flex;align-items:center;gap:6px}
  .sjbf-usp li::before{content:"";width:7px;height:7px;border-radius:50%;background:#FF5EA8}
  .sjbf-cta{display:flex;flex-wrap:wrap;gap:10px;margin-top:8px}
  .sjbf-cta a{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:0 22px;border-radius:8px;font-weight:700;font-size:17px;text-decoration:none;transition:background-color .2s,color .2s}
  .sjbf-b1{background:#FFC72C;color:#0A2E4D!important}
  .sjbf-b1:hover{background:#FFD45C}
  .sjbf-b2{border:2px solid rgba(255,255,255,.85);color:#fff!important}
  .sjbf-b2:hover{background:rgba(255,255,255,.12)}
  .sjbf-cta a:focus-visible{outline:3px solid #FFC72C;outline-offset:3px}
  .sjbf-fine{margin:4px 0 0;font-size:12.5px;color:#AFC1D3;max-width:52ch}
  @media (min-width:768px){
    .sjbf-usp li:nth-child(3){display:flex}
    .sjbf-usp,.sjbf-fine{max-width:56%}
    .sjbf-art img{object-position:right center}
    .sjbf-in{padding:44px 32px;min-height:clamp(340px,40vw,560px);justify-content:center}
    .sjbf-h{font-size:clamp(56px,6.4vw,96px)!important;max-width:12ch}
    .sjbf-offer{font-size:clamp(40px,4.4vw,64px)}
    .sjbf-in{background:linear-gradient(90deg,rgba(6,25,43,.55) 0,rgba(6,25,43,0) 55%)}
  }
  @media (min-width:1025px){ .sjbf-in{padding:56px 32px} .sjbf-usp,.sjbf-fine{max-width:none} }
  @media (prefers-reduced-motion:reduce){.sjbf *{transition:none!important}}
</style>

{% schema %}
{
  "name": "SJ Black Friday banner",
  "class": "sjbf-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "SJ Sports, Woolloongabba" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Friday" },
    { "type": "text", "id": "heading_2", "label": "Heading, second line (pink)", "default": "is on" },
    { "type": "text", "id": "offer", "label": "Offer line", "info": "Leave empty until the offer is set. Shows in yellow under the heading." },
    { "type": "text", "id": "btn1_label", "label": "Main button", "default": "Shop the sale" },
    { "type": "url", "id": "btn1_url", "label": "Main button link" },
    { "type": "text", "id": "btn2_label", "label": "Second button", "default": "Shop bats" },
    { "type": "url", "id": "btn2_url", "label": "Second button link" },
    { "type": "text", "id": "fine", "label": "Small print" }
  ],
  "presets": [{ "name": "SJ Black Friday banner" }]
}
{% endschema %}

{%- comment -%}
  SJ CRO 11 (Off Leesh, Nov 2026): a short intro under the collection heading on the main
  collections. Uses the text here; falls back to the collection description only when it is short.
{%- endcomment -%}
{%- liquid
  assign intro = ''
  for block in section.blocks
    if block.settings.collection.handle == collection.handle
      assign intro = block.settings.text
      break
    endif
  endfor
  if intro == blank and collection.description != blank
    assign plain = collection.description | strip_html | strip
    if plain.size < 260
      assign intro = '<p>' | append: plain | append: '</p>'
    endif
  endif
-%}
{%- if intro != blank -%}
  <div class="sj-intro t4s-container">{{ intro }}</div>
{%- endif -%}

{% schema %}
{
  "name": "SJ collection intro",
  "settings": [],
  "blocks": [
    {
      "type": "intro",
      "name": "Intro",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "richtext", "id": "text", "label": "Intro text" }
      ]
    }
  ],
  "presets": [{ "name": "SJ collection intro" }]
}
{% endschema %}
